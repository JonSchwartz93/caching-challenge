{
  "compilerOptions": {
    /* Checking only - esbuild performs the actual transpilation. */
    "noEmit": true,

    /* Language and environment */
    "target": "es2016",
    "module": "commonjs",
    "jsx": "react",

    /* Interop */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type checking */
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["application", "caching-fetch-library", "framework"],
  "exclude": ["node_modules", "dist"]
}
